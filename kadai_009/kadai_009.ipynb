      "source": [
        "arrays = [\"水\", \"金\", \"地\", \"火\", \"木\", \"土\", \"天\", \"海\", \"冥\"]\n",
        "\n",
        "# 1. for loop\n",
        "for array in arrays:\n",
        "    print(array)\n",
        "\n",
        "# 2. while loop\n",
        "index = 0\n",
        "while index < 9:\n",
        "    print(arrays[index])\n",
        "    index += 1  # Move to the next element"
      ],
